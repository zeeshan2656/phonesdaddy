# ==============================================================================
# PhonesDaddy - Git Safe Deployment Configuration
# Prevents accidental overwrite of production database, uploaded images & settings
# ==============================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and Secret Configurations (NEVER commit or overwrite production .env)
.env
.env.*
!.env.example

# Dynamic Media & Uploads (Stored OUTSIDE the deployment repository)
/server/uploads/
/public/webfiles/
phonesdaddy_uploads/
phonesdaddy_webfiles/
phonesdaddy_media/

# Database Backups & SQL Dumps (Never commit local database dumps)
*.sql
*.sql.gz
/backups/
!/backups/.gitkeep
/database/dumps/

# Deployment Bundles & Release Archives
/deploy/
/deploy-bundle/
deploy-bundle.zip
*.zip
*.tar.gz

# System, IDE and Logs
*.log
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Scratch & Test Scripts
/scratch/
