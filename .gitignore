# ==============================================================================
# PhonesDaddy - Git Safe Deployment Configuration
# Prevents accidental overwrite of production database, uploaded images & settings
# ==============================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and Secret Configurations (NEVER commit or overwrite production .env)
.env
.env.*
!.env.example

# Dynamic User Uploads & Photos (Protects server images from local overwrites)
/server/uploads/*
!/server/uploads/*/.gitkeep
/public/webfiles/phones/*
!/public/webfiles/phones/.gitkeep
/public/webfiles/news/*
!/public/webfiles/news/.gitkeep

# Database Backups & SQL Dumps (Never commit local database dumps)
*.sql
*.sql.gz
/backups/
!/backups/.gitkeep
/database/dumps/

# Deployment Bundles & Release Archives
/deploy/
/deploy-bundle/
deploy-bundle.zip
*.zip
*.tar.gz

# System, IDE and Logs
*.log
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Scratch & Test Scripts
/scratch/
