PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=phonesdaddy
DB_USER=root
DB_PASSWORD=

SESSION_SECRET=phonesdaddy_super_secret_session_key_2026
NODE_ENV=production

# ==============================================================================
# Persistent Media Storage (ZERO-RISK DEPLOYMENTS)
# ==============================================================================
# Set MEDIA_DIR on your production server to a directory OUTSIDE the deployment folder.
# This ensures that when you deploy via Git pull or extract a ZIP file, your media
# is 100% safe and will NEVER be replaced by an empty folder.
#
# Examples:
#   Hostinger Shared / cPanel:  MEDIA_DIR=../phonesdaddy_media
#   Absolute path:             MEDIA_DIR=/home/yourusername/phonesdaddy_media
#   VPS / Ubuntu:              MEDIA_DIR=/var/phonesdaddy_media
MEDIA_DIR=../phonesdaddy_media
